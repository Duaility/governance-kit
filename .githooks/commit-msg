#!/usr/bin/env bash
# governance-kit:managed pack-version=0.1 generated=2026-04-23
# Governance commit-msg hook — generated from selected pack rules.
#
# Escape hatches:
#   SKIP_GOVERNANCE=1 git commit ...
#   git commit --no-verify

set -u

if [[ "${SKIP_GOVERNANCE:-0}" == "1" ]]; then
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
RULES_DIR="$ROOT/tests/governance/rules"
MSG_FILE="$1"

if [[ -x "$RULES_DIR/agent-token-accounting/check.sh" ]]; then
    if ! bash "$RULES_DIR/agent-token-accounting/check.sh" "$MSG_FILE"; then
        echo "✗ commit blocked by governance (agent-token-accounting)" >&2
        exit 1
    fi
fi

if [[ -x "$RULES_DIR/commit-issue-plan-match/check.sh" ]]; then
    if ! bash "$RULES_DIR/commit-issue-plan-match/check.sh" "$MSG_FILE"; then
        echo "✗ commit blocked by governance (commit-issue-plan-match)" >&2
        exit 1
    fi
fi

if [[ -x "$RULES_DIR/conventional-commits/check.sh" ]]; then
    if ! bash "$RULES_DIR/conventional-commits/check.sh" "$MSG_FILE"; then
        echo "✗ commit blocked by governance (conventional-commits)" >&2
        exit 1
    fi
fi

exit 0
