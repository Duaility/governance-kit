#!/usr/bin/env bash
# Governance commit-msg hook — validates the pending commit message.
# Currently runs only the conventional-commits rule (if installed).
#
# Escape hatches:
#   SKIP_GOVERNANCE=1 git commit ...   # telegraphs intent; CI still enforces
#   git commit --no-verify             # skips all hooks

set -u

if [[ "${SKIP_GOVERNANCE:-0}" == "1" ]]; then
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
CC_RULE="$ROOT/tests/governance/rules/conventional-commits.sh"
ATA_RULE="$ROOT/tests/governance/rules/agent-token-accounting.sh"

if [[ -x "$CC_RULE" ]]; then
    if ! bash "$CC_RULE" "$1"; then
        cat >&2 <<EOF

────────────────────────────────────────
✗ Commit message blocked by governance (conventional-commits).

Format:
    <type>(<optional-scope>)!?: <subject> (#123)

Types: feat, fix, chore, docs, refactor, test, perf, build, ci, revert, style.
Example: fix(auth): reject tokens with empty 'sub' claim (#123)

Bypass (CI will still enforce on PR):
    SKIP_GOVERNANCE=1 git commit ...
    git commit --no-verify
────────────────────────────────────────
EOF
        exit 1
    fi
fi

if [[ -x "$ATA_RULE" ]]; then
    if ! bash "$ATA_RULE" "$1"; then
        cat >&2 <<EOF

────────────────────────────────────────
✗ Commit message blocked by governance (agent-token-accounting).

An agent-authored commit must carry the full trailer set and have a matching
append-only row in COSTS.md. See:
    governance-bootstrap/references/AGENT_TOKEN_ACCOUNTING.md

Bypass (CI will still enforce on PR):
    SKIP_GOVERNANCE=1 git commit ...
    git commit --no-verify
────────────────────────────────────────
EOF
        exit 1
    fi
fi

exit 0
