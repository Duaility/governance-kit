#!/usr/bin/env bash
# governance-kit:managed pack-version=0.1 generated=2026-04-23
# Governance pre-commit hook — generated from selected pack rules.
#
# Escape hatches:
#   SKIP_GOVERNANCE=1 git commit ...    # telegraphs intent; CI still enforces
#   git commit --no-verify              # skips all hooks

set -u

if [[ "${SKIP_GOVERNANCE:-0}" == "1" ]]; then
    echo "⊘ governance pre-commit skipped (SKIP_GOVERNANCE=1)" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
RULES_DIR="$ROOT/tests/governance/rules"

# Rule-owned pre-commit helpers (side effects — run before validation).
if [[ -x "$RULES_DIR/agent-token-accounting/hooks/pre-commit.sh" ]]; then
    bash "$RULES_DIR/agent-token-accounting/hooks/pre-commit.sh" || exit 1
fi

fail=0
if [[ -x "$RULES_DIR/agents-md-exists/check.sh" ]]; then
    bash "$RULES_DIR/agents-md-exists/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/constitution-exists/check.sh" ]]; then
    bash "$RULES_DIR/constitution-exists/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/dotenv-gitignored/check.sh" ]]; then
    bash "$RULES_DIR/dotenv-gitignored/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/hooks-configured/check.sh" ]]; then
    bash "$RULES_DIR/hooks-configured/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/issues-tracked/check.sh" ]]; then
    bash "$RULES_DIR/issues-tracked/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/no-broken-internal-doc-links/check.sh" ]]; then
    bash "$RULES_DIR/no-broken-internal-doc-links/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/no-committed-build-artifacts/check.sh" ]]; then
    bash "$RULES_DIR/no-committed-build-artifacts/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/no-large-files/check.sh" ]]; then
    bash "$RULES_DIR/no-large-files/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/no-merge-conflict-markers/check.sh" ]]; then
    bash "$RULES_DIR/no-merge-conflict-markers/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/no-secrets/check.sh" ]]; then
    bash "$RULES_DIR/no-secrets/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/plan-per-issue/check.sh" ]]; then
    bash "$RULES_DIR/plan-per-issue/check.sh" || fail=1
fi
if [[ -x "$RULES_DIR/workflows-hardened/check.sh" ]]; then
    bash "$RULES_DIR/workflows-hardened/check.sh" || fail=1
fi

if [[ $fail -ne 0 ]]; then
    cat >&2 <<EOF

────────────────────────────────────────
✗ Commit blocked by governance.

Fix the violations above, or bypass (CI will still enforce):
    SKIP_GOVERNANCE=1 git commit ...
    git commit --no-verify
────────────────────────────────────────
EOF
    exit 1
fi

exit 0
