#!/usr/bin/env bash
# governance-kit:managed pack-version=0.1 generated=2026-04-23
# Governance pre-commit hook — generated by governance-bootstrap.
#
# Escape hatches:
#   SKIP_GOVERNANCE=1 git commit ...    # telegraphs intent; CI still enforces
#   git commit --no-verify              # skips all hooks

set -u

if [[ "${SKIP_GOVERNANCE:-0}" == "1" ]]; then
    echo "⊘ governance pre-commit skipped (SKIP_GOVERNANCE=1)" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
RULES_DIR="$ROOT/tests/governance/rules"

rule_field() {
    local manifest="$1" field="$2"
    [[ -f "$manifest" ]] || return 0
    awk -v k="$field" '
        /^[[:space:]]*#/ { next }
        $0 ~ "^[[:space:]]*" k ":[[:space:]]*" {
            line = $0
            sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", line)
            sub(/[[:space:]]+#.*$/, "", line)
            sub(/^[[:space:]]+/, "", line)
            sub(/[[:space:]]+$/, "", line)
            if (line ~ /^".*"$/ || line ~ /^'\''.*'\''$/) {
                line = substr(line, 2, length(line) - 2)
            }
            print line
            exit
        }
    ' "$manifest"
}

rule_ids_for_hook() {
    local kind="$1" mode="$2"
    local dir id hook helper
    [[ -d "$RULES_DIR" ]] || return 0
    for dir in "$RULES_DIR"/*; do
        [[ -d "$dir" && -f "$dir/rule.yaml" ]] || continue
        id="${dir##*/}"
        hook="$(rule_field "$dir/rule.yaml" hook)"
        helper="$dir/hooks/$kind.sh"
        case "$mode" in
            helper)
                [[ -x "$helper" ]] && printf '%s\n' "$id"
                ;;
            check)
                [[ "$hook" == "$kind" && -x "$dir/check.sh" ]] && printf '%s\n' "$id"
                ;;
        esac
    done | sort
}
while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    bash "$RULES_DIR/$id/hooks/pre-commit.sh" || exit 1
done < <(rule_ids_for_hook pre-commit helper)

fail=0
while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    bash "$RULES_DIR/$id/check.sh" || fail=1
done < <(rule_ids_for_hook pre-commit check)

if [[ -x "$ROOT/scripts/test-packs.sh" && -d "$ROOT/governance/assets/packs" ]]; then
    if ! command -v uv >/dev/null 2>&1; then
        echo "⊘ pack tests skipped: \`uv\` not installed locally (CI still enforces)" >&2
    else
        (
            cd "$ROOT" || exit 1
            # Clear inherited git env vars (GIT_INDEX_FILE, GIT_DIR, etc.) so
            # nested `git` calls inside test-packs.sh operate on temp repos
            # cleanly instead of inheriting the in-progress commit context.
            while IFS= read -r name; do
                [[ -n "$name" ]] && unset "$name"
            done < <(git rev-parse --local-env-vars)
            bash "$ROOT/scripts/test-packs.sh"
        ) || fail=1
    fi
fi

if [[ $fail -ne 0 ]]; then
    cat >&2 <<EOF

────────────────────────────────────────
✗ Commit blocked by governance.

Fix the violations above, or bypass (CI will still enforce):
    SKIP_GOVERNANCE=1 git commit ...
    git commit --no-verify
────────────────────────────────────────
EOF
    exit 1
fi

exit 0
